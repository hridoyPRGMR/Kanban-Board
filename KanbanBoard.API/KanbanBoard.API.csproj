<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.11" />
  <!-- Microsoft.AspNetCore.OpenApi removed to avoid conflicting Microsoft.OpenApi transitive versions with Swashbuckle -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.0" />
    
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../KanbanBoard.Application/KanbanBoard.Application.csproj" />
    <ProjectReference Include="../KanbanBoard.Infrastructure/KanbanBoard.Infrastructure.csproj" />
    <ProjectReference Include="../KanbanBoard.Shared/KanbanBoard.Shared.csproj" />
  </ItemGroup>

</Project>
